{
  "name": "@aurora/desktop",
  "productName": "Aurora",
  "version": "0.5.6",
  "private": true,
  "description": "Aurora Electron 桌面壳",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node ../../scripts/fetch-officecli.mjs && electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "node ../../scripts/fetch-officecli.mjs && pnpm run build && electron-builder --win --publish never",
    "release:win": "node ../../scripts/fetch-officecli.mjs && pnpm run build && electron-builder --win --publish always",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run"
  },
  "dependencies": {
    "@aurora/agent-core": "workspace:*",
    "@aurora/modes": "workspace:*",
    "@aurora/shared": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "officeparser": "7.8.0",
    "pdf-lib": "1.17.1",
    "systeminformation": "^5.23.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@aurora/center": "workspace:*",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.0",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
