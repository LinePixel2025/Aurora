{
  "name": "@aurora/desktop",
  "productName": "Aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora Electron 桌面壳",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "pnpm run build && electron-builder --win --publish never",
    "release:win": "pnpm run build && electron-builder --win --publish always",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run"
  },
  "dependencies": {
    "@aurora/agent-core": "workspace:*",
    "@aurora/modes": "workspace:*",
    "@aurora/shared": "workspace:*",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "officeparser": "7.8.0",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.0",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
