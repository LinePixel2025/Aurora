{
  "name": "@aurora/shared",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Aurora 共享类型、配置 Schema、SettingsStore 与 IPC 契约",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser/markdown/md.css": "./dist/browser/markdown/md.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/browser/markdown',{recursive:true});fs.copyFileSync('src/browser/markdown/md.css','dist/browser/markdown/md.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "zod": "^3.24.1"
  }
}
