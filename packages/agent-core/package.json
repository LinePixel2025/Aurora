{
  "name": "@aurora/agent-core",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Aurora Agent 内核（纯 Node，不依赖 Electron / DOM）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
