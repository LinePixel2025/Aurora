{
  "name": "@aurora/center",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Aurora Center —— 网页控制中心服务器 + CLI（docs/12）",
  "bin": {
    "aurora-center": "./bin/aurora-center.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "verify:web": "node verify/run.mjs",
    "verify:web:status": "node verify/status-dump.mjs"
  },
  "dependencies": {
    "@aurora/shared": "workspace:*",
    "ws": "^8.18.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^5.2.0",
    "echarts": "^6.1.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
